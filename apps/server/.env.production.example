# Co-Space Server - Production Environment Configuration Template
# Copy this file to apps/server/.env for direct Node production execution.
# The backend does not automatically load .env.production.

NODE_ENV=production
PORT=5000

# Database Configuration (MySQL 8)
DATABASE_URL="mysql://cospace_user:your_secure_db_password@localhost:3306/cospace_db"

# JWT Authentication
# Must be a cryptographically random secret of at least 32 characters
JWT_SECRET="replace_with_a_production_random_secret_key_at_least_32_characters"
# Valid duration with explicit unit (s, m, h, d), e.g. 2h, 1d
JWT_EXPIRES_IN="2h"

# Password Hashing Cost (Integer between 10 and 14)
BCRYPT_SALT_ROUNDS=12

# Client Application URL (Allowed CORS Origin)
CLIENT_URL="https://cospace.example.com"

# Cloudinary Storage Configuration for Room Images
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# Nodemailer / Gmail SMTP Configuration
# Defaults: smtp.gmail.com / 587 / false (STARTTLS); use 465 / true for implicit TLS.
# Empty credentials disable email. Invalid SMTP disables email with a safe warning;
# the backend still starts. Restart the backend after correcting configuration.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
# Gmail requires an App Password and an authenticated/authorized sender.
SMTP_FROM='"Co-Space Working" <no-reply@co-space.local>'
# SMTP_* takes precedence over legacy GMAIL_USER/GMAIL_APP_PASSWORD/EMAIL_FROM.
# Process environment overrides dotenv values. Never commit real credentials.
