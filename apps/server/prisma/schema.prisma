datasource db {
  provider          = "mysql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -------------------------------------------------------------
// ENUMS
// -------------------------------------------------------------

enum Role {
  ADMIN
  CUSTOMER
}

enum RoomStatus {
  AVAILABLE
  MAINTENANCE
  ARCHIVED
}

enum BookingStatus {
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum PaymentStatus {
  UNPAID
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
}

enum EmailOutboxStatus {
  QUEUED
  SENT
  FAILED
  SKIPPED
}

enum EmailOutboxKind {
  BOOKING_CONFIRMATION
  BOOKING_CANCELLATION
  BOOKING_REMINDER
  BOOKING_RESCHEDULED
  EMAIL_VERIFICATION
}

enum PaymentMethod {
  CASH
  QR
}

// -------------------------------------------------------------
// MODELS
// -------------------------------------------------------------

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  fullName     String   @map("full_name")
  phoneNumber  String?  @map("phone_number")
  role         Role     @default(CUSTOMER)
  // CWB-77: bumped on password change/reset and "log out everywhere"; JWTs carry it as `tv`.
  tokenVersion Int      @default(0) @map("token_version")
  // CWB-79: set while an admin has locked the account (null = active); reason shown to admins.
  lockedAt     DateTime? @map("locked_at")
  lockReason   String?   @map("lock_reason") @db.VarChar(500)
  // CWB-87: timestamp of email verification (null = unverified; new registrations remain null).
  emailVerifiedAt DateTime? @map("email_verified_at")
  // CWB-88: set when the customer deleted the account; personal data is anonymized, bookings kept.
  deletedAt    DateTime? @map("deleted_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  bookings                Booking[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  emailOutbox             EmailOutbox[]
  createdClosures         Closure[]            @relation("UserCreatedClosures")

  @@map("users")
}

// One-time password reset tokens (CWB-64). Only the SHA-256 hash of the emailed token is stored.
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// One-time email verification tokens (CWB-87). Only the SHA-256 hash of the emailed token is stored.
model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

model Room {
  id           String     @id @default(uuid())
  name         String     @unique
  description  String?    @db.Text
  capacity     Int
  pricePerHour Decimal    @map("price_per_hour") @db.Decimal(10, 2)
  status       RoomStatus @default(AVAILABLE)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  images        RoomImage[]
  amenities     RoomAmenity[]
  bookings      Booking[]
  statusHistory RoomStatusHistory[]
  closures      Closure[]

  @@map("rooms")
}

model RoomStatusHistory {
  id          String     @id @default(uuid())
  roomId      String     @map("room_id")
  status      RoomStatus
  effectiveAt DateTime   @map("effective_at") @db.DateTime(3)

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([roomId, effectiveAt])
  @@map("room_status_history")
}

model Amenity {
  id          String   @id @default(uuid())
  name        String   @unique
  icon        String? // Tên icon (e.g. 'wifi', 'tv', 'coffee')
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  rooms RoomAmenity[]

  @@map("amenities")
}

// Bảng trung gian Room - Amenity (N - N)
model RoomAmenity {
  roomId    String   @map("room_id")
  amenityId String   @map("amenity_id")
  createdAt DateTime @default(now()) @map("created_at")

  room    Room    @relation(fields: [roomId], references: [id], onDelete: Cascade)
  amenity Amenity @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@id([roomId, amenityId])
  @@index([amenityId])
  @@map("room_amenities")
}

model RoomImage {
  id        String   @id @default(uuid())
  roomId    String   @map("room_id")
  imageUrl  String   @map("image_url") @db.VarChar(500)
  publicId  String?  @map("public_id") // Cloudinary public_id để xóa ảnh
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at")

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId])
  @@map("room_images")
}

model Booking {
  id                        String         @id @default(uuid())
  bookingCode               String         @unique @map("booking_code") // e.g. CS-20260915-ABCD
  userId                    String?        @map("user_id")
  roomId                    String         @map("room_id")
  startTime                 DateTime       @map("start_time")
  endTime                   DateTime       @map("end_time")
  totalAmount               Decimal        @map("total_amount") @db.Decimal(12, 2)
  note                      String?        @db.Text
  status                    BookingStatus  @default(CONFIRMED)
  paymentStatus             PaymentStatus  @default(UNPAID) @map("payment_status")
  paymentMethod             PaymentMethod? @map("payment_method")
  checkedInAt               DateTime?      @map("checked_in_at")
  attendanceTrackingEnabled Boolean        @default(true) @map("attendance_tracking_enabled")
  cancellationReason        String?        @map("cancellation_reason") @db.Text
  cancelledAt               DateTime?      @map("cancelled_at")
  cancelledBy               Role?          @map("cancelled_by")
  refundedAmount            Decimal        @default(0.00) @map("refunded_amount") @db.Decimal(12, 2)
  createdAt                 DateTime       @default(now()) @map("created_at")
  updatedAt                 DateTime       @updatedAt @map("updated_at")

  guestName  String? @map("guest_name") @db.VarChar(191)
  guestPhone String? @map("guest_phone") @db.VarChar(191)

  // CWB-66: retry identification. Scope is `user:<id>` / `admin:<id>`; hash is SHA-256 of the
  // normalized create payload so a reused key with a different payload is rejected.
  idempotencyScope String? @map("idempotency_scope") @db.VarChar(191)
  idempotencyKey   String? @map("idempotency_key") @db.VarChar(64)
  idempotencyHash  String? @map("idempotency_hash") @db.Char(64)

  user        User?         @relation(fields: [userId], references: [id], onDelete: Restrict)
  room        Room          @relation(fields: [roomId], references: [id], onDelete: Restrict)
  emailOutbox EmailOutbox[]
  refunds                   Refund[]

  @@unique([idempotencyScope, idempotencyKey], map: "bookings_idempotency_scope_key_key")
  // Composite index cực kỳ quan trọng cho availability query (StartA < EndB AND EndA > StartB)
  @@index([roomId, startTime, endTime, status])
  @@index([userId])
  @@index([startTime, id])
  @@index([status, attendanceTrackingEnabled, checkedInAt, endTime], map: "bookings_attendance_no_show_idx")
  @@map("bookings")
}


model Refund {
  id        String        @id @default(uuid())
  bookingId String        @map("booking_id")
  amount    Decimal       @db.Decimal(12, 2)
  method    PaymentMethod
  reason    String        @db.VarChar(500)
  actorId   String        @map("actor_id") @db.VarChar(191)
  createdAt DateTime      @default(now()) @map("created_at")

  booking   Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@map("refunds")
}

// CWB-67: append-only audit trail of important admin mutations, written in the same
// transaction as the change. Actor comes from the verified JWT; no FK so history survives
// account deletion. Never store passwords, tokens or secrets in before/after.
model AuditEvent {
  id         String   @id @default(uuid())
  /// Insertion order; breaks createdAt ties so the trail is read in commit order.
  sequence   Int      @unique @default(autoincrement())
  actorId    String   @map("actor_id") @db.VarChar(191)
  actorRole  Role     @map("actor_role")
  action     String   @db.VarChar(64)
  entityType String   @map("entity_type") @db.VarChar(32)
  entityId   String   @map("entity_id") @db.VarChar(191)
  before     Json?
  after      Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId, sequence])
  @@index([createdAt])
  @@map("audit_events")
}

/// CWB-68, CWB-87: durable email outbox written in the booking or registration transaction.
/// Stores no recipient or token; the email is rendered at send time. Delivery is at-least-once.
model EmailOutbox {
  id            String            @id @default(uuid())
  kind          EmailOutboxKind
  bookingId     String?           @map("booking_id")
  booking       Booking?          @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  userId        String?           @map("user_id")
  user          User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  status        EmailOutboxStatus @default(QUEUED)
  attempts      Int               @default(0)
  nextAttemptAt DateTime          @default(now()) @map("next_attempt_at")
  lastError     String?           @map("last_error") @db.VarChar(64)
  sentAt        DateTime?         @map("sent_at")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  @@unique([kind, bookingId], map: "email_outbox_kind_booking_key")
  @@index([status, nextAttemptAt])
  @@index([bookingId])
  @@index([userId])
  @@map("email_outbox")
}

model Closure {
  id          String   @id @default(uuid())
  roomId      String?  @map("room_id")
  startTime   DateTime @map("start_time")
  endTime     DateTime @map("end_time")
  reason      String   @db.Text
  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  room      Room? @relation(fields: [roomId], references: [id], onDelete: Cascade)
  createdBy User  @relation("UserCreatedClosures", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([roomId, startTime, endTime])
  @@index([startTime, endTime])
  @@map("closures")
}
