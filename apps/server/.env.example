PORT=5000
NODE_ENV=development
# Default: false for direct access (including production without a proxy).
# true trusts exactly one reverse proxy; block all direct backend access first.
TRUST_PROXY=false
CLIENT_URL=http://localhost:5173

DATABASE_URL="your_database_connection_string_here"
SHADOW_DATABASE_URL="your_shadow_database_connection_string_here"

# JWT Configuration (required, minimum 32 characters)
JWT_SECRET="your-super-secret-jwt-key-minimum-32-chars-long"
JWT_EXPIRES_IN="1h"
# Positive integer followed by s, m, h or d (e.g. 900s, 15m, 1h).

# Bcrypt Configuration (safe range: 10 - 14)
BCRYPT_SALT_ROUNDS=10

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# Nodemailer / Gmail SMTP Configuration
# Defaults: smtp.gmail.com / 587 / false (STARTTLS); use 465 / true for implicit TLS.
# Empty credentials disable email. Invalid SMTP disables email with a safe warning;
# the backend still starts. Restart the backend after correcting configuration.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
# Gmail requires an App Password and an authenticated/authorized sender.
SMTP_FROM='"Co-Space Working" <no-reply@co-space.local>'
# SMTP_* takes precedence over legacy GMAIL_USER/GMAIL_APP_PASSWORD/EMAIL_FROM.
# Process environment overrides dotenv values. Never commit real credentials.

# Optional integration tests only: dedicated MySQL database name must end in _test.
# Use a DB account restricted to that schema; never reuse the development schema.
# TEST_DATABASE_URL="mysql://test_user:REPLACE_ME@localhost:3306/cospace_test"
