# Co-Space Working - Root Docker Compose Production Configuration
# Copy to .env for docker compose deployment

# Database
DB_NAME=cospace_db
DB_USER=cospace_user
DB_PASSWORD=replace_with_secure_production_password
DB_ROOT_PASSWORD=replace_with_secure_root_password
DB_PORT=3306

# Server
PORT=5000
JWT_SECRET=replace_with_a_production_random_secret_key_at_least_32_characters
JWT_EXPIRES_IN=2h
BCRYPT_SALT_ROUNDS=12
CLIENT_URL=http://localhost

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Nodemailer / Gmail SMTP
# Defaults: smtp.gmail.com / 587 / false; use 465 / true for implicit TLS.
# Leave credentials empty to disable email. Invalid SMTP disables email safely;
# the backend still starts. Restart the backend after correcting configuration.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# For Gmail, use an App Password and your authenticated/authorized sender.
SMTP_FROM='"Co-Space Working" <no-reply@co-space.local>'
# SMTP_* takes precedence over legacy GMAIL_USER/GMAIL_APP_PASSWORD/EMAIL_FROM.
# Process environment overrides dotenv values. Never commit real credentials.

# Client
CLIENT_PORT=80
